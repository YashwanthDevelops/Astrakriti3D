FROM python:3.12-slim-bookworm@sha256:1aaa65a85fda306ffb8b910824d4e93bdce61e212c7e87168123ea3073b41a1a

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TMPDIR=/var/lib/astrakriti/companion/tmp \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/astrakriti
COPY pyproject.toml ./
COPY astrakriti3d/ ./astrakriti3d/
COPY integrations/ ./integrations/
COPY scripts/run_companion.py ./scripts/run_companion.py

RUN python -m pip install --no-cache-dir \
        'requests==2.32.3' 'psutil==6.0.0' 'Flask==3.1.3' 'gunicorn==23.0.0' \
        'numpy==2.1.3' 'opencv-python-headless==4.10.0.84' \
    && useradd --system --uid 10001 --home-dir /var/lib/astrakriti astrakriti \
    && mkdir -p /var/lib/astrakriti/companion/tmp \
    && chown -R astrakriti:astrakriti /var/lib/astrakriti

USER 10001:10001
EXPOSE 5001

CMD ["gunicorn", "--bind=0.0.0.0:5001", "--workers=1", "--threads=4", "--timeout=0", "scripts.run_companion:app"]
